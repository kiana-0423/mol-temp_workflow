atom_style full
units real

bond_style harmonic
angle_style harmonic
dihedral_style opls
improper_style cvff

pair_style lj/charmm/coul/long 9.0 11.0
pair_modify mix geometric

kspace_style pppm 0.0001

read_data  system.data
include    system.in.settings


timestep       1.0  


neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
thermo 200
thermo_style custom step temp pe ke etotal press vol density fmax

dump            d1 all custom 1000 dump.relax.lammpstrj id type mol x y z vx vy vz
dump_modify     d1 sort id

min_style       cg
minimize        1.0e-6 1.0e-8 5000 20000

velocity        all create 300.0 12345 mom yes rot yes dist gaussian


fix             nvt1 all nvt temp 300.0 300.0 100.0   
run             5000000                                
unfix           nvt1

undump          d1

write_restart   restart.final
